#!/usr/bin/env bash
# /ewomail/sbin/ewomail-helper
#
# Runs root-only operations on behalf of the admin panel (PHP/www-data).
# Reachable via sudo with strict /etc/sudoers.d/ewomail rules. Every argument
# is validated before any privileged action is taken; no arbitrary commands
# are ever passed to a shell.

set -Eeuo pipefail
umask 077

# acme.sh detects SUDO_USER and refuses to run ("It seems that you are using
# sudo, please read this page first…"). We ARE root here (sudo-elevated from
# www-data) which is fine — clear the sudo trail so child processes don't
# see it. Also clean other variables that downstream tools can trip on.
unset SUDO_USER SUDO_UID SUDO_GID SUDO_COMMAND

usage() {
    cat >&2 <<EOF
ewomail-helper <command> [args...]

Firewall:
  fw-list                                  show open ports (inbound, zone)
  fw-add    <port>/<tcp|udp>               open inbound port permanently
  fw-del    <port>/<tcp|udp>               close inbound port permanently
  fw-out-add  <port>/<tcp|udp>             block outbound (OUTPUT REJECT)
  fw-out-del  <port>/<tcp|udp>             allow outbound
  fw-out-list                              list outbound-blocked ports
  fw-block  <ip>                           rich-rule reject from IP
  fw-unblock <ip>
  fw-allowlist-add <ip>
  fw-allowlist-del <ip>
  fw-reload

Nginx:
  nginx-list                               list site files
  nginx-test                               nginx -t
  nginx-reload                             reload nginx
  nginx-cat   <name>                       cat sites-available/<name>
  nginx-save  <name>                       write stdin to sites-available/<name>
  nginx-enable  <name>
  nginx-disable <name>
  nginx-version                            print running nginx version
  nginx-upgrade                            backup, switch to nginx.org repo,
                                           upgrade, test, rollback on failure

Certificate:
  cert-issue <fqdn>                        --issue via webroot at /ewomail/www/default
  cert-renew <fqdn>
  cert-list
  cert-install <fqdn>                      copy current cert to /etc/ssl/ewomail
  cert-backup                              download deployed cert/key as .tar.gz
  cert-restore                            restore .tar.gz from stdin and reload services

Service:
  svc-status <name>
  svc-restart <name>                       (whitelist of names only)

Setting:
  setting-rotate-admin-path
  setting-rotate-db-path
  setting-toggle-db <on|off>
EOF
    exit 2
}

valid_port_proto() {
    [[ "$1" =~ ^([0-9]{1,5})/(tcp|udp)$ ]] || return 1
    local p="${BASH_REMATCH[1]}"
    (( p >= 1 && p <= 65535 ))
}
valid_ipv4() {
    [[ "$1" =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$ ]] || return 1
    local a b c d
    a="${BASH_REMATCH[1]}"; b="${BASH_REMATCH[2]}"; c="${BASH_REMATCH[3]}"; d="${BASH_REMATCH[4]}"
    (( a <= 255 && b <= 255 && c <= 255 && d <= 255 ))
}
valid_fqdn()      { [[ "$1" =~ ^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$ ]]; }
valid_site_name() { [[ "$1" =~ ^[a-zA-Z0-9._-]+\.conf$ && ! "$1" == *..* ]]; }
valid_url_path()  { [[ "$1" =~ ^(adm|db)-[a-z0-9]+$ ]]; }    # for rotated paths
acme_install_cert() {
    local domain="$1"

    # acme.sh 默认存 ECC；先试 --ecc，取不到再回退老 RSA 路径。
    # reloadcmd 用 `|| true` 包每个 systemctl reload —— 即便某个服务（比如
    # 用户暂时停了 dovecot）reload 失败，也不让 acme.sh 整体返回非零。
    /root/.acme.sh/acme.sh --install-cert -d "${domain}" --ecc \
        --key-file       /etc/ssl/ewomail/private/privkey.pem \
        --fullchain-file /etc/ssl/ewomail/fullchain.pem \
        --reloadcmd      "systemctl reload nginx 2>/dev/null || true; systemctl reload postfix 2>/dev/null || true; systemctl reload dovecot 2>/dev/null || true" \
        || /root/.acme.sh/acme.sh --install-cert -d "${domain}" \
        --key-file       /etc/ssl/ewomail/private/privkey.pem \
        --fullchain-file /etc/ssl/ewomail/fullchain.pem \
        --reloadcmd      "systemctl reload nginx 2>/dev/null || true; systemctl reload postfix 2>/dev/null || true; systemctl reload dovecot 2>/dev/null || true"
}

# 判断 acme.sh 本地账户是否已有该域名证书。返回 0 = 有；不调任何 LE API。
acme_has_domain_cert() {
    local domain="$1"
    /root/.acme.sh/acme.sh --list --listraw 2>/dev/null | awk -F'|' -v d="${domain}" '
        NR == 1 && $1 ~ /Main_Domain/ { next }
        {
            gsub(/^[ \t]+|[ \t.]+$/, "", $1)
            if ($1 == d) found = 1
        }
        END { exit found ? 0 : 1 }
    '
}

reload_mail_tls_services() {
    systemctl reload nginx 2>/dev/null || true
    systemctl reload postfix 2>/dev/null || true
    systemctl reload dovecot 2>/dev/null || true
}

cert_key_matches() {
    local cert="$1" key="$2" tmpdir cert_pub key_pub
    tmpdir=$(mktemp -d)
    trap 'rm -rf "${tmpdir}"' RETURN
    cert_pub="${tmpdir}/cert.pub"
    key_pub="${tmpdir}/key.pub"
    openssl x509 -in "${cert}" -pubkey -noout >"${cert_pub}" 2>/dev/null || return 1
    openssl pkey -in "${key}" -pubout >"${key_pub}" 2>/dev/null || return 1
    cmp -s "${cert_pub}" "${key_pub}"
}

valid_service() {
    case "$1" in
        nginx|postfix|dovecot|amavis|spamassassin|clamav-daemon|clamav-freshclam|\
        mariadb|fail2ban|firewalld) return 0 ;;
        php*-fpm)
            [[ "$1" =~ ^php8\.[2-9]-fpm$ ]]   # 8.2 .. 8.9
            ;;
        *) return 1 ;;
    esac
}

ZONE="ewomail"

cmd="${1:-}"
shift || true
[[ -z "${cmd}" ]] && usage

case "${cmd}" in
    # ---- Firewall ----
    fw-list)
        firewall-cmd --zone="${ZONE}" --list-all
        ;;
    fw-add)
        [[ $# -eq 1 ]] && valid_port_proto "$1" || usage
        firewall-cmd --permanent --zone="${ZONE}" --add-port="$1"
        firewall-cmd --reload
        ;;
    fw-del)
        [[ $# -eq 1 ]] && valid_port_proto "$1" || usage
        # SSH 端口绝不允许通过此 helper 关闭。有些 VPS 没有外层安全组
        # （RackNerd 等小厂常见），关掉 22 后 SSH 立刻断开 = 失联。
        # UI 也会把 22 过滤掉，但这里再加一道防御。
        if [[ "$1" == "22/tcp" || "$1" == "22/udp" ]]; then
            echo "refused: 22/tcp/udp 是 SSH 端口，不允许通过此面板关闭" >&2
            exit 2
        fi
        firewall-cmd --permanent --zone="${ZONE}" --remove-port="$1"
        firewall-cmd --reload
        ;;
    fw-block)
        [[ $# -eq 1 ]] && valid_ipv4 "$1" || usage
        firewall-cmd --permanent --zone="${ZONE}" \
            --add-rich-rule="rule family=ipv4 source address=$1 reject"
        firewall-cmd --reload
        ;;
    fw-unblock)
        [[ $# -eq 1 ]] && valid_ipv4 "$1" || usage
        firewall-cmd --permanent --zone="${ZONE}" \
            --remove-rich-rule="rule family=ipv4 source address=$1 reject" || true
        firewall-cmd --reload
        ;;
    fw-allowlist-add)
        [[ $# -eq 1 ]] && valid_ipv4 "$1" || usage
        firewall-cmd --permanent --zone=trusted --add-source="$1"
        firewall-cmd --reload
        ;;
    fw-allowlist-del)
        [[ $# -eq 1 ]] && valid_ipv4 "$1" || usage
        firewall-cmd --permanent --zone=trusted --remove-source="$1" || true
        firewall-cmd --reload
        ;;
    fw-reload)
        firewall-cmd --reload
        ;;

    # ---- 出站邮件总开关 ----
    # 关闭：iptables direct rule REJECT 出向 25/tcp + 移除入向 465/587
    # 这样既阻止本机往外发邮件（即使账号被盗也无法群发），
    # 又阻止外部用户用 465/587 通过本机做中继。
    # 出向 25 通常 SMTP 客户端用，入向 465/587 是 Submission 接口。
    outbound-disable)
        # 委托给底层 fw-out-add 来加 OUTPUT REJECT 规则，这样和单端口出方向
        # 切换共用同一套机制。
        "$0" fw-out-add 25/tcp >/dev/null
        firewall-cmd --permanent --zone="${ZONE}" --remove-port=465/tcp 2>/dev/null || true
        firewall-cmd --permanent --zone="${ZONE}" --remove-port=587/tcp 2>/dev/null || true
        firewall-cmd --reload
        mysql -uroot ewomail -e "REPLACE INTO i_panel_setting VALUES ('outbound_disabled','yes')"
        ;;
    outbound-enable)
        "$0" fw-out-del 25/tcp >/dev/null
        firewall-cmd --permanent --zone="${ZONE}" --add-port=465/tcp 2>/dev/null || true
        firewall-cmd --permanent --zone="${ZONE}" --add-port=587/tcp 2>/dev/null || true
        firewall-cmd --reload
        mysql -uroot ewomail -e "REPLACE INTO i_panel_setting VALUES ('outbound_disabled','no')"
        ;;
    outbound-status)
        # 之前用 firewall-cmd --direct --query-rule 来判断，但 Debian 12+ 的
        # firewalld 默认 nftables 后端，--direct 是 compat 层，query-rule 的
        # exit code 偶尔不可靠。改用 DB 标志位作为权威：每次 disable/enable
        # 都会同步写 DB，状态查询直接读 DB 即可，不再触发 firewall-cmd。
        state=$(mysql -uroot -N -B ewomail -e \
            "SELECT value FROM i_panel_setting WHERE name='outbound_disabled'" 2>/dev/null)
        [[ "${state}" == "yes" ]] && echo yes || echo no
        ;;

    # ---- 单端口出方向（OUTPUT REJECT）----
    # 给每个端口提供和入方向类似的开关。22/tcp/udp 仍然拒绝操作。
    fw-out-add)
        [[ $# -eq 1 ]] && valid_port_proto "$1" || usage
        if [[ "$1" == "22/tcp" || "$1" == "22/udp" ]]; then
            echo "refused: 22 是 SSH 端口" >&2; exit 2
        fi
        p_port="${1%/*}"; p_proto="${1#*/}"
        firewall-cmd --permanent --direct --add-rule ipv4 filter OUTPUT 100 \
            -p "${p_proto}" --dport "${p_port}" -j REJECT 2>/dev/null || true
        firewall-cmd --permanent --direct --add-rule ipv6 filter OUTPUT 100 \
            -p "${p_proto}" --dport "${p_port}" -j REJECT 2>/dev/null || true
        firewall-cmd --reload
        ;;
    fw-out-del)
        [[ $# -eq 1 ]] && valid_port_proto "$1" || usage
        p_port="${1%/*}"; p_proto="${1#*/}"
        firewall-cmd --permanent --direct --remove-rule ipv4 filter OUTPUT 100 \
            -p "${p_proto}" --dport "${p_port}" -j REJECT 2>/dev/null || true
        firewall-cmd --permanent --direct --remove-rule ipv6 filter OUTPUT 100 \
            -p "${p_proto}" --dport "${p_port}" -j REJECT 2>/dev/null || true
        firewall-cmd --reload
        ;;
    fw-out-list)
        # 输出当前出方向被 REJECT 的端口，一行一个 port/proto。
        # 解析 `firewall-cmd --get-rules ipv4 filter OUTPUT` 的输出，形如：
        #   100 -p tcp --dport 25 -j REJECT
        firewall-cmd --permanent --direct --get-rules ipv4 filter OUTPUT 2>/dev/null | \
        while IFS= read -r line; do
            proto=$(echo "${line}" | sed -nE 's/.*-p (tcp|udp).*/\1/p')
            port=$(echo "${line}"  | sed -nE 's/.*--dport ([0-9]+).*/\1/p')
            [[ -n "${port}" && -n "${proto}" ]] && echo "${port}/${proto}"
        done | sort -u
        ;;


    # ---- Nginx ----
    nginx-list)
        # Output: <name>\t<enabled|disabled>, one site per line. PHP-FPM's
        # open_basedir hides /etc/nginx, so the panel relies on us for this.
        for f in /etc/nginx/sites-available/*.conf; do
            [[ -f "$f" ]] || continue
            base=$(basename "$f")
            if [[ -L "/etc/nginx/sites-enabled/${base}" || -e "/etc/nginx/sites-enabled/${base}" ]]; then
                printf '%s\tenabled\n' "${base}"
            else
                printf '%s\tdisabled\n' "${base}"
            fi
        done
        ;;
    nginx-test)
        nginx -t 2>&1
        ;;
    nginx-reload)
        nginx -t >/dev/null
        systemctl reload nginx
        ;;
    nginx-cat)
        [[ $# -eq 1 ]] && valid_site_name "$1" || usage
        [[ -f "/etc/nginx/sites-available/$1" ]] || { echo "no such site" >&2; exit 1; }
        cat "/etc/nginx/sites-available/$1"
        ;;
    nginx-save)
        [[ $# -eq 1 ]] && valid_site_name "$1" || usage
        tmp=$(mktemp); trap 'rm -f "$tmp"' EXIT
        cat > "$tmp"
        # Validate by including just this file via a throwaway test.
        cp "/etc/nginx/sites-available/$1" "/etc/nginx/sites-available/$1.bak" 2>/dev/null || true
        install -m 0644 "$tmp" "/etc/nginx/sites-available/$1"
        if ! nginx -t >/dev/null 2>&1; then
            [[ -f "/etc/nginx/sites-available/$1.bak" ]] && mv "/etc/nginx/sites-available/$1.bak" "/etc/nginx/sites-available/$1"
            echo "nginx -t failed; reverted" >&2
            exit 3
        fi
        rm -f "/etc/nginx/sites-available/$1.bak"
        systemctl reload nginx
        ;;
    nginx-enable)
        [[ $# -eq 1 ]] && valid_site_name "$1" || usage
        ln -sf "/etc/nginx/sites-available/$1" "/etc/nginx/sites-enabled/$1"
        nginx -t >/dev/null && systemctl reload nginx
        ;;
    nginx-disable)
        [[ $# -eq 1 ]] && valid_site_name "$1" || usage
        rm -f "/etc/nginx/sites-enabled/$1"
        nginx -t >/dev/null && systemctl reload nginx
        ;;

    # 输出当前 nginx 版本号（裸数字，例如 1.22.1）
    nginx-version)
        nginx -v 2>&1 | sed -E 's/^nginx version: nginx\///; s/ .*$//'
        ;;

    # 把 nginx 升级到 nginx.org stable（典型 1.30.x）。
    # 风险点：
    #   1) nginx.org 包默认 user nginx + 不用 sites-enabled。--force-confold
    #      保留我们 Debian 版本的 nginx.conf（user www-data + sites-enabled）。
    #   2) nginx.org 包自带 conf.d/default.conf 占 80 端口，会和我们的 vhost
    #      撞 server_name —— 装完检测一下把它禁掉。
    #   3) 任何一步失败都 rm -rf /etc/nginx + 把备份 mv 回来，配置 100% 还原。
    nginx-upgrade)
        # 自己管错误处理，需要 rollback 路径
        set +e

        bak="/etc/nginx.bak-$(date +%Y%m%d-%H%M%S)"
        cp -a /etc/nginx "${bak}" || { echo "ERROR: 备份 /etc/nginx 失败" >&2; exit 1; }
        echo "backup=${bak}"

        rollback() {
            echo "正在回滚到 ${bak} …" >&2
            rm -rf /etc/nginx
            mv "${bak}" /etc/nginx
            nginx -t 2>&1 || true
        }

        # 1) 配 nginx.org repo（如果还没；和 install/lib/packages.sh 同一份逻辑）
        if [[ ! -f /etc/apt/sources.list.d/nginx-stable.list ]]; then
            echo "step=adding-nginx-org-repo"
            install -d -m 0755 /etc/apt/keyrings
            if ! curl -fsSL https://nginx.org/keys/nginx_signing.key \
                    | gpg --dearmor -o /etc/apt/keyrings/nginx.gpg 2>&1; then
                echo "ERROR: 获取 nginx.org 签名密钥失败（网络问题？）" >&2
                rollback; exit 2
            fi
            chmod 0644 /etc/apt/keyrings/nginx.gpg
            codename=$(. /etc/os-release && echo "${VERSION_CODENAME}")
            cat > /etc/apt/sources.list.d/nginx-stable.list <<EOF
deb [signed-by=/etc/apt/keyrings/nginx.gpg] https://nginx.org/packages/debian ${codename} nginx
EOF
            cat > /etc/apt/preferences.d/nginx-stable <<'EOF'
Package: nginx
Pin: origin nginx.org
Pin-Priority: 900
EOF
        fi

        # 2) apt-get update
        echo "step=apt-update"
        if ! DEBIAN_FRONTEND=noninteractive apt-get update 2>&1; then
            echo "ERROR: apt-get update 失败" >&2
            rollback; exit 3
        fi

        # 3) apt-get install nginx —— --force-confold 保留我们的 nginx.conf
        echo "step=apt-install"
        if ! DEBIAN_FRONTEND=noninteractive apt-get install -y \
                -o Dpkg::Options::="--force-confdef" \
                -o Dpkg::Options::="--force-confold" \
                nginx 2>&1; then
            echo "ERROR: apt install nginx 失败" >&2
            rollback; exit 4
        fi

        # 4) 禁掉 nginx.org 自带的 default.conf（占 80 端口会和 ewomail.conf 撞）
        if [[ -f /etc/nginx/conf.d/default.conf ]]; then
            mv /etc/nginx/conf.d/default.conf /etc/nginx/conf.d/default.conf.disabled
            echo "note=已禁用 nginx.org 默认 conf.d/default.conf（防止占 80）"
        fi

        # 5) nginx -t
        echo "step=nginx-t"
        test_out=$(nginx -t 2>&1)
        test_rc=$?
        if [[ $test_rc -ne 0 ]]; then
            echo "ERROR: nginx -t 失败:" >&2
            echo "${test_out}" >&2
            rollback; exit 5
        fi

        # 6) 重启 nginx：
        # 之前这步只 reload + fallback restart 然后 || true 吃错误，结果：
        #   apt 的 prerm 给老 nginx 发 SIGTERM 时，nginx workers 还在帮 PHP-FPM
        #   转发"正在调 helper"的那个 ajax 请求（workers 等连接 drain）→ 5 秒
        #   不退 → systemd SIGKILL → unit 进入 failed 状态。等 helper 跑到这里
        #   时 nginx 进程根本不在了，reload 必然失败；restart 又撞上 systemd
        #   的 "Device or resource busy"（unit 缓存没刷）。最后 || true 让
        #   helper 假装成功退出，nginx 实际没起来 = 整站 502。
        #
        # 正确顺序：
        #   a) daemon-reload —— 让 systemd 重新加载 nginx 的 unit 文件
        #      （apt 装新版时可能换了内容）
        #   b) reset-failed —— 清掉上面那个 SIGKILL 留下的 failed 状态
        #   c) start —— 明确启动（不是 reload，进程已经死了）
        #   d) is-active 轮询验证，确认真的起来；不然就 rollback
        echo "step=daemon-reload"
        systemctl daemon-reload 2>&1 || true
        systemctl reset-failed nginx 2>&1 || true

        echo "step=start"
        if ! systemctl start nginx 2>&1; then
            echo "ERROR: systemctl start nginx 失败" >&2
            rollback; exit 6
        fi

        echo "step=verify"
        sleep 1
        ok=0
        for i in 1 2 3 4 5 6 7 8; do
            if systemctl is-active --quiet nginx; then
                ok=1; break
            fi
            sleep 1
        done
        if [[ $ok -ne 1 ]]; then
            echo "ERROR: nginx 启动后未保持 active 状态" >&2
            journalctl -u nginx -n 20 --no-pager 2>&1 || true
            rollback; exit 7
        fi

        new_ver=$(nginx -v 2>&1 | sed -E 's/^nginx version: nginx\///; s/ .*$//')
        echo "version=${new_ver}"
        echo "done"
        ;;

    # ---- Cert ----
    cert-issue)
        [[ $# -eq 1 ]] && valid_fqdn "$1" || usage
        # 反复重装会撞 LE 的"5 个完全一样 FQDN 集合 / 周"限流。如果 acme.sh
        # 本地已经有这张证书，就直接 install 部署，根本不碰 LE API。
        # 输出"reusing-existing-cert"标记，让 PHP 端给用户区分提示。
        if acme_has_domain_cert "$1"; then
            echo "reusing-existing-cert"
            acme_install_cert "$1"
            exit 0
        fi
        /root/.acme.sh/acme.sh --issue -d "$1" -w /ewomail/www/default --server letsencrypt
        ;;
    cert-renew)
        [[ $# -eq 1 ]] && valid_fqdn "$1" || usage
        # 不带 --force：被强制续签时 acme.sh 会下一个新的 ACME order，
        # 反复重装期间这是撞 LE 限流的主要途径之一。不带时 acme.sh 自己
        # 决定是否到期；没到就退非零 + "Skip"/"Next renewal time" 提示，
        # PHP 端会兜底改去跑 cert-install 重新部署当前证书。
        if /root/.acme.sh/acme.sh --renew -d "$1" --ecc; then
            acme_install_cert "$1"
        elif /root/.acme.sh/acme.sh --renew -d "$1"; then
            acme_install_cert "$1"
        fi
        ;;
    cert-list)
        # --listraw modifies --list to use stable pipe-delimited columns:
        #   Main_Domain|KeyLength|SAN_Domains|CA|Created|Renew
        # Running `--listraw` alone just prints the help text — must combine.
        /root/.acme.sh/acme.sh --list --listraw
        ;;
    cert-current)
        # Subject + Not After + epoch mtime of the deployed cert. PHP can't
        # see /etc/ssl/ewomail (out of open_basedir), so it asks us.
        if [[ -f /etc/ssl/ewomail/fullchain.pem ]]; then
            openssl x509 -in /etc/ssl/ewomail/fullchain.pem -noout -subject -enddate 2>/dev/null
            stat -c 'mtime=%Y' /etc/ssl/ewomail/fullchain.pem 2>/dev/null
        else
            echo 'missing'
        fi
        ;;
    cert-install)
        [[ $# -eq 1 ]] && valid_fqdn "$1" || usage
        acme_install_cert "$1"
        ;;

    cert-backup)
        # Write only the archive to stdout. Diagnostics go to stderr so PHP can
        # safely stream the response as a browser download.
        [[ -f /etc/ssl/ewomail/fullchain.pem && -f /etc/ssl/ewomail/private/privkey.pem ]] || {
            echo 'missing deployed certificate or private key' >&2
            exit 1
        }
        tar -C / -czf - etc/ssl/ewomail/fullchain.pem etc/ssl/ewomail/private/privkey.pem
        ;;
    cert-restore)
        [[ $# -eq 0 ]] || usage
        tmpdir=$(mktemp -d)
        cleanup() { rm -rf "${tmpdir}"; }
        trap cleanup EXIT
        cat > "${tmpdir}/upload.tar.gz"
        [[ -s "${tmpdir}/upload.tar.gz" ]] || { echo 'empty backup file' >&2; exit 1; }

        tar -tzf "${tmpdir}/upload.tar.gz" > "${tmpdir}/files.txt" || { echo 'invalid tar.gz backup' >&2; exit 1; }
        while IFS= read -r name; do
            case "${name}" in
                etc/ssl/ewomail/fullchain.pem|etc/ssl/ewomail/private/privkey.pem) ;;
                *) echo "unexpected file in backup: ${name}" >&2; exit 1 ;;
            esac
        done < "${tmpdir}/files.txt"

        tar -C "${tmpdir}" -xzf "${tmpdir}/upload.tar.gz"
        cert="${tmpdir}/etc/ssl/ewomail/fullchain.pem"
        key="${tmpdir}/etc/ssl/ewomail/private/privkey.pem"
        [[ -s "${cert}" && -s "${key}" ]] || { echo 'backup must contain fullchain.pem and privkey.pem' >&2; exit 1; }
        openssl x509 -in "${cert}" -noout >/dev/null 2>&1 || { echo 'invalid certificate PEM' >&2; exit 1; }
        openssl pkey -in "${key}" -noout >/dev/null 2>&1 || { echo 'invalid private key PEM' >&2; exit 1; }
        cert_key_matches "${cert}" "${key}" || { echo 'certificate and private key do not match' >&2; exit 1; }

        stamp=$(date +%Y%m%d%H%M%S)
        mkdir -p /etc/ssl/ewomail/private /etc/ssl/ewomail/backup
        [[ -f /etc/ssl/ewomail/fullchain.pem ]] && cp -a /etc/ssl/ewomail/fullchain.pem "/etc/ssl/ewomail/backup/fullchain.pem.${stamp}"
        [[ -f /etc/ssl/ewomail/private/privkey.pem ]] && cp -a /etc/ssl/ewomail/private/privkey.pem "/etc/ssl/ewomail/backup/privkey.pem.${stamp}"
        install -m 0644 -o root -g root "${cert}" /etc/ssl/ewomail/fullchain.pem
        install -m 0600 -o root -g root "${key}" /etc/ssl/ewomail/private/privkey.pem
        reload_mail_tls_services
        echo 'restored'
        ;;

    # ---- Service ----
    svc-status)
        [[ $# -eq 1 ]] && valid_service "$1" || usage
        systemctl status "$1" --no-pager
        ;;
    svc-restart)
        [[ $# -eq 1 ]] && valid_service "$1" || usage
        systemctl restart "$1"
        ;;

    # ---- 数据导入 / 导出 ----
    # 只导出邮件相关业务表的 INSERT 语句（不带 CREATE TABLE，schema 由
    # install.sql 创建），方便老版 EwoMail / 新版 EwoMail-plus 之间互相迁移。
    db-export)
        mysqldump -uroot --no-create-info --skip-add-locks --skip-comments \
            --skip-extended-insert --hex-blob --default-character-set=utf8mb4 \
            --single-transaction \
            ewomail i_users i_domains i_aliases i_bcc_user i_quota i_day_record 2>/dev/null || \
        # i_day_record 在某些老版本里不存在；不带它再试一次
        mysqldump -uroot --no-create-info --skip-add-locks --skip-comments \
            --skip-extended-insert --hex-blob --default-character-set=utf8mb4 \
            --single-transaction \
            ewomail i_users i_domains i_aliases i_bcc_user i_quota
        ;;
    db-import)
        # stdin: 来自任意 mysqldump 的 SQL；可能含 CREATE/DROP/admin/system_config 等等
        # 处理流程：
        #   1) 查目标库实际存在的业务表（i_day_record 这种可能没有）→ 动态白名单
        #   2) grep 只挑白名单内表的 INSERT 语句（拒收 DROP TABLE / CREATE / DELETE）
        #   3) INSERT INTO → INSERT IGNORE INTO（已存在 email/name 就跳过，不覆盖）
        #   4) 落到 mysql；同时输出按表统计供 PHP 显示
        tmp=$(mktemp); trap 'rm -f "${tmp}"' EXIT

        existing=$(mysql -uroot -N -B ewomail -e "
            SELECT TABLE_NAME FROM INFORMATION_SCHEMA.TABLES
            WHERE TABLE_SCHEMA = DATABASE()
              AND TABLE_NAME IN ('i_users','i_domains','i_aliases','i_bcc_user','i_quota','i_day_record')
        ")
        if [[ -z "${existing}" ]]; then
            echo "ERROR: 目标数据库里找不到任何邮件业务表，请确认 install.sql 已执行" >&2
            exit 1
        fi
        # 把多行表名拼成 regex alternation
        pattern=$(printf '%s\n' "${existing}" | tr '\n' '|' | sed 's/|$//')

        grep -E "^INSERT (IGNORE )?INTO \`?(${pattern})\`?" \
            | sed -E 's/^INSERT INTO /INSERT IGNORE INTO /' > "${tmp}" || true
        if [[ ! -s "${tmp}" ]]; then
            echo "ERROR: SQL 中找不到任何可识别的 INSERT 语句。本机可写入的表：${existing//$'\n'/, }" >&2
            exit 1
        fi
        # 先按表统计要插入的行数，给前端展示
        awk '{
            if (match($0, /^INSERT IGNORE INTO `?([a-z_]+)`?/, m)) cnt[m[1]]++
        } END {
            for (t in cnt) printf "table=%s count=%d\n", t, cnt[t]
        }' "${tmp}"
        # 再实际应用
        mysql -uroot ewomail < "${tmp}"
        echo "applied=ok"
        ;;

    # ---- Setting ----
    setting-rotate-admin-path)
        new="adm-$(tr -dc 'a-z0-9' </dev/urandom | head -c 16)"
        old=$(mysql -uroot -N -B ewomail -e "SELECT value FROM i_panel_setting WHERE name='admin_path'")
        # Defence in depth: even though only this helper writes the column, refuse to act if its value has been tampered with.
        valid_url_path "${old}" || { echo "stored admin_path looks wrong; aborting" >&2; exit 4; }
        mysql -uroot ewomail -e "UPDATE i_panel_setting SET value='${new}' WHERE name='admin_path'"
        sed -i "s|/${old}/|/${new}/|g; s|/${old}\$|/${new}|g" /etc/nginx/sites-available/ewomail.conf
        nginx -t >/dev/null && systemctl reload nginx
        echo "${new}"
        ;;
    setting-rotate-db-path)
        new="db-$(tr -dc 'a-z0-9' </dev/urandom | head -c 16)"
        old=$(mysql -uroot -N -B ewomail -e "SELECT value FROM i_panel_setting WHERE name='db_path'")
        valid_url_path "${old}" || { echo "stored db_path looks wrong; aborting" >&2; exit 4; }
        mysql -uroot ewomail -e "UPDATE i_panel_setting SET value='${new}' WHERE name='db_path'"
        sed -i "s|/${old}/|/${new}/|g" /etc/nginx/sites-available/ewomail.conf
        nginx -t >/dev/null && systemctl reload nginx
        echo "${new}"
        ;;
    setting-toggle-db)
        case "${1:-}" in
            on)  state=yes ;;
            off) state=no  ;;
            *)   usage ;;
        esac
        mysql -uroot ewomail -e "UPDATE i_panel_setting SET value='${state}' WHERE name='db_admin_enable'"
        conf=/etc/nginx/sites-available/ewomail.conf
        # Always ensure exactly one of the two states is present:
        #   disabled → a line "return 404; # EWOMAIL_DB_DISABLED" inside the location
        #   enabled  → that line absent
        sed -i '/return 404; # EWOMAIL_DB_DISABLED/d' "${conf}"
        if [[ "${state}" == "no" ]]; then
            sed -i '/alias \/ewomail\/www\/adminer\/;/a\        return 404; # EWOMAIL_DB_DISABLED' "${conf}"
        fi
        nginx -t >/dev/null && systemctl reload nginx
        ;;

    *) usage ;;
esac
