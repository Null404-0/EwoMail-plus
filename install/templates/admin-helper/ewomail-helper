#!/usr/bin/env bash
# /ewomail/sbin/ewomail-helper
#
# Runs root-only operations on behalf of the admin panel (PHP/www-data).
# Reachable via sudo with strict /etc/sudoers.d/ewomail rules. Every argument
# is validated before any privileged action is taken; no arbitrary commands
# are ever passed to a shell.

set -Eeuo pipefail
umask 077

# acme.sh detects SUDO_USER and refuses to run ("It seems that you are using
# sudo, please read this page first…"). We ARE root here (sudo-elevated from
# www-data) which is fine — clear the sudo trail so child processes don't
# see it. Also clean other variables that downstream tools can trip on.
unset SUDO_USER SUDO_UID SUDO_GID SUDO_COMMAND

usage() {
    cat >&2 <<EOF
ewomail-helper <command> [args...]

Firewall:
  fw-list                                  show open ports
  fw-add    <port>/<tcp|udp>               open a port permanently
  fw-del    <port>/<tcp|udp>               close a port permanently
  fw-block  <ip>                           rich-rule reject from IP
  fw-unblock <ip>
  fw-allowlist-add <ip>
  fw-allowlist-del <ip>
  fw-reload

Nginx:
  nginx-list                               list site files
  nginx-test                               nginx -t
  nginx-reload                             reload nginx
  nginx-cat   <name>                       cat sites-available/<name>
  nginx-save  <name>                       write stdin to sites-available/<name>
  nginx-enable  <name>
  nginx-disable <name>

Certificate:
  cert-issue <fqdn>                        --issue via webroot at /ewomail/www/default
  cert-renew <fqdn>
  cert-list
  cert-install <fqdn>                      copy current cert to /etc/ssl/ewomail

Service:
  svc-status <name>
  svc-restart <name>                       (whitelist of names only)

Setting:
  setting-rotate-admin-path
  setting-rotate-db-path
  setting-toggle-db <on|off>
EOF
    exit 2
}

valid_port_proto() {
    [[ "$1" =~ ^([0-9]{1,5})/(tcp|udp)$ ]] || return 1
    local p="${BASH_REMATCH[1]}"
    (( p >= 1 && p <= 65535 ))
}
valid_ipv4() {
    [[ "$1" =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$ ]] || return 1
    local a b c d
    a="${BASH_REMATCH[1]}"; b="${BASH_REMATCH[2]}"; c="${BASH_REMATCH[3]}"; d="${BASH_REMATCH[4]}"
    (( a <= 255 && b <= 255 && c <= 255 && d <= 255 ))
}
valid_fqdn()      { [[ "$1" =~ ^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$ ]]; }
valid_site_name() { [[ "$1" =~ ^[a-zA-Z0-9._-]+\.conf$ && ! "$1" == *..* ]]; }
valid_url_path()  { [[ "$1" =~ ^(adm|db)-[a-z0-9]+$ ]]; }    # for rotated paths
valid_service() {
    case "$1" in
        nginx|postfix|dovecot|amavis|spamassassin|clamav-daemon|clamav-freshclam|\
        mariadb|fail2ban|firewalld) return 0 ;;
        php*-fpm)
            [[ "$1" =~ ^php8\.[2-9]-fpm$ ]]   # 8.2 .. 8.9
            ;;
        *) return 1 ;;
    esac
}

ZONE="ewomail"

cmd="${1:-}"
shift || true
[[ -z "${cmd}" ]] && usage

case "${cmd}" in
    # ---- Firewall ----
    fw-list)
        firewall-cmd --zone="${ZONE}" --list-all
        ;;
    fw-add)
        [[ $# -eq 1 ]] && valid_port_proto "$1" || usage
        firewall-cmd --permanent --zone="${ZONE}" --add-port="$1"
        firewall-cmd --reload
        ;;
    fw-del)
        [[ $# -eq 1 ]] && valid_port_proto "$1" || usage
        # SSH 端口绝不允许通过此 helper 关闭。有些 VPS 没有外层安全组
        # （RackNerd 等小厂常见），关掉 22 后 SSH 立刻断开 = 失联。
        # UI 也会把 22 过滤掉，但这里再加一道防御。
        if [[ "$1" == "22/tcp" || "$1" == "22/udp" ]]; then
            echo "refused: 22/tcp/udp 是 SSH 端口，不允许通过此面板关闭" >&2
            exit 2
        fi
        firewall-cmd --permanent --zone="${ZONE}" --remove-port="$1"
        firewall-cmd --reload
        ;;
    fw-block)
        [[ $# -eq 1 ]] && valid_ipv4 "$1" || usage
        firewall-cmd --permanent --zone="${ZONE}" \
            --add-rich-rule="rule family=ipv4 source address=$1 reject"
        firewall-cmd --reload
        ;;
    fw-unblock)
        [[ $# -eq 1 ]] && valid_ipv4 "$1" || usage
        firewall-cmd --permanent --zone="${ZONE}" \
            --remove-rich-rule="rule family=ipv4 source address=$1 reject" || true
        firewall-cmd --reload
        ;;
    fw-allowlist-add)
        [[ $# -eq 1 ]] && valid_ipv4 "$1" || usage
        firewall-cmd --permanent --zone=trusted --add-source="$1"
        firewall-cmd --reload
        ;;
    fw-allowlist-del)
        [[ $# -eq 1 ]] && valid_ipv4 "$1" || usage
        firewall-cmd --permanent --zone=trusted --remove-source="$1" || true
        firewall-cmd --reload
        ;;
    fw-reload)
        firewall-cmd --reload
        ;;

    # ---- 出站邮件总开关 ----
    # 关闭：iptables direct rule REJECT 出向 25/tcp + 移除入向 465/587
    # 这样既阻止本机往外发邮件（即使账号被盗也无法群发），
    # 又阻止外部用户用 465/587 通过本机做中继。
    # 出向 25 通常 SMTP 客户端用，入向 465/587 是 Submission 接口。
    outbound-disable)
        firewall-cmd --permanent --direct --add-rule ipv4 filter OUTPUT 100 -p tcp --dport 25 -j REJECT 2>/dev/null || true
        firewall-cmd --permanent --direct --add-rule ipv6 filter OUTPUT 100 -p tcp --dport 25 -j REJECT 2>/dev/null || true
        firewall-cmd --permanent --zone="${ZONE}" --remove-port=465/tcp 2>/dev/null || true
        firewall-cmd --permanent --zone="${ZONE}" --remove-port=587/tcp 2>/dev/null || true
        firewall-cmd --reload
        mysql -uroot ewomail -e "REPLACE INTO i_panel_setting VALUES ('outbound_disabled','yes')"
        ;;
    outbound-enable)
        firewall-cmd --permanent --direct --remove-rule ipv4 filter OUTPUT 100 -p tcp --dport 25 -j REJECT 2>/dev/null || true
        firewall-cmd --permanent --direct --remove-rule ipv6 filter OUTPUT 100 -p tcp --dport 25 -j REJECT 2>/dev/null || true
        firewall-cmd --permanent --zone="${ZONE}" --add-port=465/tcp 2>/dev/null || true
        firewall-cmd --permanent --zone="${ZONE}" --add-port=587/tcp 2>/dev/null || true
        firewall-cmd --reload
        mysql -uroot ewomail -e "REPLACE INTO i_panel_setting VALUES ('outbound_disabled','no')"
        ;;
    outbound-status)
        if firewall-cmd --permanent --direct --query-rule ipv4 filter OUTPUT 100 -p tcp --dport 25 -j REJECT 2>/dev/null; then
            echo yes
        else
            echo no
        fi
        ;;

    # ---- Nginx ----
    nginx-list)
        # Output: <name>\t<enabled|disabled>, one site per line. PHP-FPM's
        # open_basedir hides /etc/nginx, so the panel relies on us for this.
        for f in /etc/nginx/sites-available/*.conf; do
            [[ -f "$f" ]] || continue
            base=$(basename "$f")
            if [[ -L "/etc/nginx/sites-enabled/${base}" || -e "/etc/nginx/sites-enabled/${base}" ]]; then
                printf '%s\tenabled\n' "${base}"
            else
                printf '%s\tdisabled\n' "${base}"
            fi
        done
        ;;
    nginx-test)
        nginx -t 2>&1
        ;;
    nginx-reload)
        nginx -t >/dev/null
        systemctl reload nginx
        ;;
    nginx-cat)
        [[ $# -eq 1 ]] && valid_site_name "$1" || usage
        [[ -f "/etc/nginx/sites-available/$1" ]] || { echo "no such site" >&2; exit 1; }
        cat "/etc/nginx/sites-available/$1"
        ;;
    nginx-save)
        [[ $# -eq 1 ]] && valid_site_name "$1" || usage
        tmp=$(mktemp); trap 'rm -f "$tmp"' EXIT
        cat > "$tmp"
        # Validate by including just this file via a throwaway test.
        cp "/etc/nginx/sites-available/$1" "/etc/nginx/sites-available/$1.bak" 2>/dev/null || true
        install -m 0644 "$tmp" "/etc/nginx/sites-available/$1"
        if ! nginx -t >/dev/null 2>&1; then
            [[ -f "/etc/nginx/sites-available/$1.bak" ]] && mv "/etc/nginx/sites-available/$1.bak" "/etc/nginx/sites-available/$1"
            echo "nginx -t failed; reverted" >&2
            exit 3
        fi
        rm -f "/etc/nginx/sites-available/$1.bak"
        systemctl reload nginx
        ;;
    nginx-enable)
        [[ $# -eq 1 ]] && valid_site_name "$1" || usage
        ln -sf "/etc/nginx/sites-available/$1" "/etc/nginx/sites-enabled/$1"
        nginx -t >/dev/null && systemctl reload nginx
        ;;
    nginx-disable)
        [[ $# -eq 1 ]] && valid_site_name "$1" || usage
        rm -f "/etc/nginx/sites-enabled/$1"
        nginx -t >/dev/null && systemctl reload nginx
        ;;

    # ---- Cert ----
    cert-issue)
        [[ $# -eq 1 ]] && valid_fqdn "$1" || usage
        /root/.acme.sh/acme.sh --issue -d "$1" -w /ewomail/www/default --server letsencrypt
        ;;
    cert-renew)
        [[ $# -eq 1 ]] && valid_fqdn "$1" || usage
        /root/.acme.sh/acme.sh --renew -d "$1" --force --ecc 2>/dev/null || \
        /root/.acme.sh/acme.sh --renew -d "$1" --force
        ;;
    cert-list)
        # --listraw modifies --list to use stable pipe-delimited columns:
        #   Main_Domain|KeyLength|SAN_Domains|CA|Created|Renew
        # Running `--listraw` alone just prints the help text — must combine.
        /root/.acme.sh/acme.sh --list --listraw
        ;;
    cert-current)
        # Subject + Not After + epoch mtime of the deployed cert. PHP can't
        # see /etc/ssl/ewomail (out of open_basedir), so it asks us.
        if [[ -f /etc/ssl/ewomail/fullchain.pem ]]; then
            openssl x509 -in /etc/ssl/ewomail/fullchain.pem -noout -subject -enddate 2>/dev/null
            stat -c 'mtime=%Y' /etc/ssl/ewomail/fullchain.pem 2>/dev/null
        else
            echo 'missing'
        fi
        ;;
    cert-install)
        [[ $# -eq 1 ]] && valid_fqdn "$1" || usage
        /root/.acme.sh/acme.sh --install-cert -d "$1" \
            --key-file       /etc/ssl/ewomail/private/privkey.pem \
            --fullchain-file /etc/ssl/ewomail/fullchain.pem \
            --reloadcmd      "systemctl reload nginx; systemctl reload postfix; systemctl reload dovecot"
        ;;

    # ---- Service ----
    svc-status)
        [[ $# -eq 1 ]] && valid_service "$1" || usage
        systemctl status "$1" --no-pager
        ;;
    svc-restart)
        [[ $# -eq 1 ]] && valid_service "$1" || usage
        systemctl restart "$1"
        ;;

    # ---- Setting ----
    setting-rotate-admin-path)
        new="adm-$(tr -dc 'a-z0-9' </dev/urandom | head -c 16)"
        old=$(mysql -uroot -N -B ewomail -e "SELECT value FROM i_panel_setting WHERE name='admin_path'")
        # Defence in depth: even though only this helper writes the column, refuse to act if its value has been tampered with.
        valid_url_path "${old}" || { echo "stored admin_path looks wrong; aborting" >&2; exit 4; }
        mysql -uroot ewomail -e "UPDATE i_panel_setting SET value='${new}' WHERE name='admin_path'"
        sed -i "s|/${old}/|/${new}/|g; s|/${old}\$|/${new}|g" /etc/nginx/sites-available/ewomail.conf
        nginx -t >/dev/null && systemctl reload nginx
        echo "${new}"
        ;;
    setting-rotate-db-path)
        new="db-$(tr -dc 'a-z0-9' </dev/urandom | head -c 16)"
        old=$(mysql -uroot -N -B ewomail -e "SELECT value FROM i_panel_setting WHERE name='db_path'")
        valid_url_path "${old}" || { echo "stored db_path looks wrong; aborting" >&2; exit 4; }
        mysql -uroot ewomail -e "UPDATE i_panel_setting SET value='${new}' WHERE name='db_path'"
        sed -i "s|/${old}/|/${new}/|g" /etc/nginx/sites-available/ewomail.conf
        nginx -t >/dev/null && systemctl reload nginx
        echo "${new}"
        ;;
    setting-toggle-db)
        case "${1:-}" in
            on)  state=yes ;;
            off) state=no  ;;
            *)   usage ;;
        esac
        mysql -uroot ewomail -e "UPDATE i_panel_setting SET value='${state}' WHERE name='db_admin_enable'"
        conf=/etc/nginx/sites-available/ewomail.conf
        # Always ensure exactly one of the two states is present:
        #   disabled → a line "return 404; # EWOMAIL_DB_DISABLED" inside the location
        #   enabled  → that line absent
        sed -i '/return 404; # EWOMAIL_DB_DISABLED/d' "${conf}"
        if [[ "${state}" == "no" ]]; then
            sed -i '/alias \/ewomail\/www\/adminer\/;/a\        return 404; # EWOMAIL_DB_DISABLED' "${conf}"
        fi
        nginx -t >/dev/null && systemctl reload nginx
        ;;

    *) usage ;;
esac
