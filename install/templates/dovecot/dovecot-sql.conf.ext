driver = mysql
connect = host=127.0.0.1 dbname=ewomail user=ewomail password=@@EWO_MYSQL_EWOMAIL_PWD@@
default_pass_scheme = MD5
password_query = \
    SELECT u.email AS user, u.password \
    FROM i_users AS u INNER JOIN i_domains AS d ON u.domain_id = d.id \
    WHERE u.email='%u' AND u.active=1 AND d.active=1
user_query = \
    SELECT maildir AS home FROM i_users WHERE email='%u'
iterate_query = SELECT email AS user FROM i_users
